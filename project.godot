; Titan Royale — projeto Godot 4
; Abre a pasta no Godot 4.2+ e carrega em Play (F5).
; Preparado para Android: renderizador compatível, paisagem, controlos táteis.

config_version=5

[application]

config/name="Titan Royale"
config/version="0.031a"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"

[autoload]

Loc="*res://scripts/Loc.gd"
Arch="*res://scripts/Archetypes.gd"
Touch="*res://scripts/TouchInput.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 4 = sensor_landscape: roda entre as duas orientações de paisagem
window/handheld/orientation=4

[input_devices]

; o rato gera eventos de toque -> dá para testar o joystick no PC
pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.063, 0.09, 1)
